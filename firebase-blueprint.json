{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User personal and fiscal data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "cpf": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["email"]
    },
    "Asset": {
      "title": "Financial Asset",
      "description": "A consolidated position in a financial instrument",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "averagePrice": { "type": "number" },
        "institution": { "type": "string" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "ticker", "type", "quantity", "averagePrice"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An operation with an asset",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "assetId": { "type": "string" },
        "type": { "type": "string", "enum": ["COMPRA", "VENDA", "RENDIMENTO", "AMORTIZACAO", "BONIFICACAO"] },
        "date": { "type": "string", "format": "date" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalValue": { "type": "number" },
        "costs": { "type": "number" },
        "irrf": { "type": "number" },
        "isDayTrade": { "type": "boolean" }
      },
      "required": ["userId", "assetId", "type", "date", "quantity", "unitPrice"]
    },
    "DARF": {
      "title": "DARF",
      "description": "Tax payment guide",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "month": { "type": "integer" },
        "year": { "type": "integer" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDENTE", "PAGO", "ATRASADO"] },
        "assetType": { "type": "string" },
        "code": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" }
      },
      "required": ["userId", "month", "year", "amount", "status", "code", "dueDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "User financial assets"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions history"
    },
    "/users/{userId}/darfs/{darfId}": {
      "schema": "DARF",
      "description": "User tax guides"
    }
  }
}
